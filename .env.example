# PostgreSQL connection string (must point at a database with pgvector installed)
DATABASE_URL=postgresql://postgres@127.0.0.1:5544/fake_review

# JWT signing secret -- generate a long random value for real deployments
JWT_SECRET=change-me-to-a-long-random-string

# Server port
PORT=4000

# Optional external IP intelligence providers. If unset, ipIntelligence.js
# falls back to a deterministic local classifier (private/reserved ranges,
# known datacenter prefixes) so the system works with zero external keys.
IP_INFO_API_KEY=
IPQUALITYSCORE_API_KEY=

# Fraud engine tuning (all optional -- see config/weights.js for defaults)
RISK_THRESHOLD_MEDIUM=30
RISK_THRESHOLD_HIGH=60
